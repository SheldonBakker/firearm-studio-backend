# Postgres connection used by the API and by dotnet ef.
# Use SSL Mode=Require unless the database is on a trusted network.
ConnectionStrings__DefaultConnection=Host=YOUR_POSTGRES_HOST;Port=5432;Database=firearmstudio;Username=firearmstudio;Password=YOUR_POSTGRES_PASSWORD;SSL Mode=Disable;Maximum Pool Size=20

# Superuser connection, used only by the integration test fixture to create and drop
# throwaway databases named firearmstudio_test_*. Not read by the API.
TestDatabase__AdminConnection=Host=YOUR_POSTGRES_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SUPERUSER_PASSWORD;SSL Mode=Disable

JwtSettings__Issuer=https://your-api-domain.example.com
JwtSettings__Audience=firearm-studio
JwtSettings__SigningKey=GENERATE_WITH_openssl_rand_base64_48
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=14

ApiKeySettings__Key=GENERATE_WITH_openssl_rand_base64_32

KlaviyoSettings__ApiKey=YOUR_KLAVIYO_PRIVATE_API_KEY_pk_...
CustomerEngagementSettings__ContactListId=YOUR_KLAVIYO_LIST_ID

NotificationSettings__PublicBaseUrl=https://your-api-domain.example.com

WahaSettings__Enabled=false
WahaSettings__BaseUrl=https://your-waha-host.example.com
WahaSettings__SessionId=default
WahaSettings__ApiKey=YOUR_WAHA_API_KEY
WahaSettings__TimeoutSeconds=10

CredentialProtectionSettings__Key=GENERATE_WITH_openssl_rand_base64_32

ASPNETCORE_ENVIRONMENT=Development
