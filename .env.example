# Copy this file to .env and fill in the values. .env is git-ignored.
# Keys use the .NET configuration convention: Section__Key (double underscore).

# Supabase Postgres connection (session mode / port 5432). REQUIRED — this is the only secret.
DatabaseSettings__ConnectionString=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.yqayiyhixfjyhkykbbsa;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Supabase auth — the project's auth URL. Issuer is derived from it and Audience defaults to "authenticated".
SupabaseJwtSettings__Authority=https://yqayiyhixfjyhkykbbsa.supabase.co/auth/v1

# ASP.NET Core environment (Development | Production).
ASPNETCORE_ENVIRONMENT=Development
